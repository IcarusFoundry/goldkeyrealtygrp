---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = 'Ken Stulik | Gold Key Realty — Northern Virginia Real Estate',
  description = 'Trusted Northern Virginia REALTOR serving Alexandria, Fairfax, and Prince William County. Expert guidance for buyers, sellers, and investors in the Bright MLS area.',
  image = '/images/og-default.jpg',
  canonicalURL = Astro.url.href,
} = Astro.props;

const nav = [
  { label: 'Buy',     href: '/buy' },
  { label: 'Sell',    href: '/sell' },
  { label: 'Listings',href: '/listings' },
  { label: 'Areas',   href: '/areas' },
  { label: 'About',   href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={image} />
  <meta property="og:site_name"   content="Gold Key Realty" />
  <meta property="og:locale"      content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={image} />

  <!-- Local Business Schema -->
  <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "RealEstateAgent",
      "name": "Gold Key Realty",
      "alternateName": "Ken Stulik — Gold Key Realty",
      "url": "https://goldkeyrealtygrp.com",
      "telephone": "(703) 309-3527",
      "areaServed": ["Alexandria, VA", "Fairfax County, VA", "Prince William County, VA"],
      "sameAs": []
    })}
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Fonts preload -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>

<body class="min-h-screen flex flex-col">

  <!-- ── Navigation ── -->
  <header id="site-header"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
    data-scrolled="false">

    <!-- Top bar -->
    <div class="bg-navy-600/95 backdrop-blur-sm border-b border-white/5 hidden md:block">
      <div class="container-site flex items-center justify-between py-2">
        <p class="font-sans text-xs text-white/50 tracking-wider">
          Serving Alexandria · Fairfax · Prince William County
        </p>
        <div class="flex items-center gap-6">
          <a href="tel:7033093527"
             class="font-sans text-xs text-gold hover:text-gold-300 tracking-wider transition-colors">
            (703) 309-3527
          </a>
          <a href="mailto:ken@goldkeyrealtygrp.com"
             class="font-sans text-xs text-white/50 hover:text-white tracking-wider transition-colors">
            ken@goldkeyrealtygrp.com
          </a>
        </div>
      </div>
    </div>

    <!-- Main nav -->
    <nav class="bg-navy-600/90 backdrop-blur-md border-b border-white/10">
      <div class="container-site flex items-center justify-between py-5">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-4 group">
          <img src="/images/gkr-logo-white.png"
               alt="Gold Key Realty"
               class="h-10 w-auto transition-opacity group-hover:opacity-90"
               onerror="this.style.display='none'" />
          <div>
            <p class="font-serif text-white text-xl font-light tracking-wide leading-none">
              Ken Stulik
            </p>
            <p class="font-sans text-gold text-[10px] tracking-[0.3em] uppercase leading-none mt-1">
              Gold Key Realty
            </p>
          </div>
        </a>

        <!-- Desktop links -->
        <ul class="hidden lg:flex items-center gap-8">
          {nav.map(item => (
            <li>
              <a href={item.href} class="nav-link">{item.label}</a>
            </li>
          ))}
        </ul>

        <!-- CTA + Mobile toggle -->
        <div class="flex items-center gap-4">
          <a href="https://goldkeyrealtygrp.lofty.com/evaluation"
             target="_blank" rel="noopener"
             class="hidden md:inline-flex btn-primary text-[11px] py-3 px-6">
            Home Valuation
          </a>

          <button id="mobile-toggle"
                  class="lg:hidden p-2 text-white hover:text-gold transition-colors"
                  aria-label="Toggle menu" aria-expanded="false">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path id="icon-open"   stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/>
              <path id="icon-close"  stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" class="hidden"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden bg-navy-700 border-t border-white/10">
        <ul class="container-site py-6 flex flex-col gap-4">
          {nav.map(item => (
            <li>
              <a href={item.href}
                 class="font-sans text-sm text-white/80 hover:text-gold tracking-widest uppercase
                        transition-colors block py-2 border-b border-white/10">
                {item.label}
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a href="https://goldkeyrealtygrp.lofty.com/evaluation"
               target="_blank" rel="noopener"
               class="btn-primary w-full justify-center text-[11px]">
              Free Home Valuation
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </header>

  <!-- ── Page content ── -->
  <main class="flex-1 pt-[108px]">
    <slot />
  </main>

  <!-- ── Footer ── -->
  <footer class="bg-navy-600 text-white">

    <!-- Main footer -->
    <div class="container-site py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

        <!-- Brand col -->
        <div class="lg:col-span-1">
          <div class="mb-6">
            <p class="font-serif text-2xl font-light text-white leading-tight">Ken Stulik</p>
            <p class="font-sans text-gold text-[11px] tracking-[0.35em] uppercase mt-1">Gold Key Realty</p>
          </div>
          <p class="font-sans text-sm text-white/50 leading-relaxed mb-6">
            Your trusted Bright MLS REALTOR serving the communities south of DC — from Old Town Alexandria to Prince William County.
          </p>
          <div class="flex gap-4">
            <!-- Social icons placeholder -->
            <a href="#" aria-label="Facebook"
               class="w-8 h-8 border border-white/20 flex items-center justify-center
                      hover:border-gold hover:text-gold transition-colors text-white/50">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="#" aria-label="Instagram"
               class="w-8 h-8 border border-white/20 flex items-center justify-center
                      hover:border-gold hover:text-gold transition-colors text-white/50">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
            <a href="#" aria-label="LinkedIn"
               class="w-8 h-8 border border-white/20 flex items-center justify-center
                      hover:border-gold hover:text-gold transition-colors text-white/50">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Quick links -->
        <div>
          <h3 class="font-sans text-[11px] tracking-[0.3em] uppercase text-gold mb-6">Services</h3>
          <ul class="space-y-3">
            {['Buy a Home', 'Sell Your Home', 'Free Valuation', 'Featured Listings', 'Rental Search', 'Market Snapshot'].map(link => (
              <li>
                <a href="#"
                   class="font-sans text-sm text-white/50 hover:text-gold transition-colors">
                  {link}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Areas -->
        <div>
          <h3 class="font-sans text-[11px] tracking-[0.3em] uppercase text-gold mb-6">Areas Served</h3>
          <ul class="space-y-3">
            {[
              'Alexandria, VA',
              'Fairfax County, VA',
              'Prince William County, VA',
              'Springfield, VA',
              'Woodbridge, VA',
              'Manassas, VA',
            ].map(area => (
              <li>
                <a href="/areas"
                   class="font-sans text-sm text-white/50 hover:text-gold transition-colors">
                  {area}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h3 class="font-sans text-[11px] tracking-[0.3em] uppercase text-gold mb-6">Contact</h3>
          <ul class="space-y-4">
            <li class="flex gap-3 items-start">
              <svg class="w-4 h-4 text-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
              </svg>
              <a href="tel:7033093527"
                 class="font-sans text-sm text-white/70 hover:text-gold transition-colors">
                (703) 309-3527
              </a>
            </li>
            <li class="flex gap-3 items-start">
              <svg class="w-4 h-4 text-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
              </svg>
              <a href="mailto:ken@goldkeyrealtygrp.com"
                 class="font-sans text-sm text-white/70 hover:text-gold transition-colors">
                ken@goldkeyrealtygrp.com
              </a>
            </li>
            <li class="flex gap-3 items-start">
              <svg class="w-4 h-4 text-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
              </svg>
              <span class="font-sans text-sm text-white/50">
                Northern Virginia &amp; DC Metro Area
              </span>
            </li>
          </ul>

          <div class="mt-8">
            <a href="/contact" class="btn-outline text-[11px] py-3 px-6">Get In Touch</a>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10">
      <div class="container-site flex flex-col md:flex-row items-center justify-between py-6 gap-4">
        <p class="font-sans text-xs text-white/30">
          &copy; {new Date().getFullYear()} Gold Key Realty. All rights reserved.
          Licensed in Virginia. Ken Stulik, REALTOR®.
        </p>
        <div class="flex gap-6">
          <a href="/privacy"  class="font-sans text-xs text-white/30 hover:text-white/60 transition-colors">Privacy Policy</a>
          <a href="/terms"    class="font-sans text-xs text-white/30 hover:text-white/60 transition-colors">Terms of Use</a>
          <a href="/sitemap-index.xml" class="font-sans text-xs text-white/30 hover:text-white/60 transition-colors">Sitemap</a>
        </div>
        <p class="font-sans text-xs text-white/20">
          Site by <span class="text-gold/40">GKR Digital</span>
        </p>
      </div>
    </div>

    <!-- Bright MLS compliance -->
    <div class="bg-navy-700 border-t border-white/5">
      <div class="container-site py-4">
        <p class="font-sans text-[10px] text-white/25 leading-relaxed">
          The data relating to real estate for sale on this website comes in part from the Bright MLS Internet Data Exchange program.
          Information is deemed reliable but not guaranteed. Copyright &copy; {new Date().getFullYear()} Bright MLS, Inc.
          All Rights Reserved. Equal Housing Opportunity.
        </p>
      </div>
    </div>

  </footer>

  <!-- ── Lofty Chat Widget ── -->
  <!-- Paste your Lofty chat script tag here -->
  <!-- <script src="https://cdn.lofty.com/chat/YOUR_SITE_ID.js" defer></script> -->

  <!-- ── Scripts ── -->
  <script>
    // Scroll-aware header
    const header = document.getElementById('site-header');
    const updateHeader = () => {
      header?.setAttribute('data-scrolled', window.scrollY > 60 ? 'true' : 'false');
    };
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();

    // Mobile menu toggle
    const toggle = document.getElementById('mobile-toggle');
    const menu   = document.getElementById('mobile-menu');
    const iconOpen  = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    toggle?.addEventListener('click', () => {
      const isOpen = menu?.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(isOpen));
      iconOpen?.classList.toggle('hidden', isOpen);
      iconClose?.classList.toggle('hidden', !isOpen);
    });

    // Intersection observer for fade-up animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(el => {
        if (el.isIntersecting) {
          el.target.classList.remove('opacity-0-init');
          el.target.classList.add('animate-fade-up');
          observer.unobserve(el.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
  </script>

</body>
</html>
