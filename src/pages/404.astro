---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Gold Key Realty">
  <section class="min-h-[70vh] flex items-center justify-center bg-cream-200">
    <div class="text-center px-6">
      <p class="font-serif text-8xl text-gold/30 font-light mb-4">404</p>
      <h1 class="font-serif text-3xl text-navy font-light mb-4">Page Not Found</h1>
      <div class="gold-rule mx-auto"></div>
      <p class="font-sans text-navy/50 mb-8 max-w-sm mx-auto">
        This key doesn't open any door we know of. Let's get you back on track.
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="/contact" class="btn-outline">Contact Ken</a>
      </div>
    </div>
  </section>
</BaseLayout>
