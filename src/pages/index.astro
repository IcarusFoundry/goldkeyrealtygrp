---
import BaseLayout from '../layouts/BaseLayout.astro';

const stats = [
  { value: '$120M+', label: 'Real Estate Sold' },
  { value: '400+',   label: 'Families Helped' },
  { value: '5.0★',   label: 'Google Rating' },
  { value: '15+',    label: 'Years in NoVA' },
];

const services = [
  {
    icon: 'buy',
    title: 'Buying a Home',
    body: 'From first-time buyers to seasoned investors, we guide you to the right property at the right price across the Bright MLS area.',
    cta: 'Start Your Search',
    href: '/buy',
  },
  {
    icon: 'sell',
    title: 'Selling Your Home',
    body: 'Strategic pricing, professional photography, and proven marketing to get you top dollar — fast. Your listing deserves more than a lockbox.',
    cta: 'Get Your Valuation',
    href: '/sell',
  },
  {
    icon: 'invest',
    title: 'Investment & Relocation',
    body: 'Relocating to the DMV? Searching for your next investment property? We know these markets from the inside out.',
    cta: 'Talk to Ken',
    href: '/contact',
  },
];

const areas = [
  { name: 'Alexandria',        sub: 'Historic Old Town & beyond',      img: 'https://images.unsplash.com/photo-1587382668460-a06d85a1a0df?w=600&q=80' },
  { name: 'Fairfax County',   sub: 'Northern Virginia\'s largest county', img: 'https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=600&q=80' },
  { name: 'Prince William',   sub: 'From Manassas to Woodbridge',      img: 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=600&q=80' },
];

const testimonials = [
  {
    quote: "Ken made our first home purchase feel effortless. He found us the perfect house in Fairfax in a competitive market — under asking price. Couldn't recommend him more.",
    name: 'Sarah & Michael T.',
    location: 'Fairfax, VA',
  },
  {
    quote: "We sold in 5 days above asking. Ken's market knowledge and his team's marketing are unmatched in Northern Virginia. Total professionals.",
    name: 'David R.',
    location: 'Old Town Alexandria',
  },
  {
    quote: "Relocated from Chicago and had no idea where to start. Ken spent three weekends showing us everything and found us a gem in Springfield. Couldn't be happier.",
    name: 'Jennifer & Tom L.',
    location: 'Springfield, VA',
  },
];

const featuredListings = [
  {
    address: '5501 Ashley Rd',
    city: 'Fairfax, VA 22030',
    price: '$1,050,000',
    beds: 5, baths: 4, sqft: '5,000+',
    status: 'Featured',
    img: 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=800&q=80',
    loftyUrl: 'https://goldkeyrealtygrp.com/listing',
  },
  {
    address: '1090 Mill Field Ct',
    city: 'Great Falls, VA 22066',
    price: '$2,495,000',
    beds: 4, baths: 6, sqft: '6,723',
    status: 'Just Listed',
    img: 'https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=800&q=80',
    loftyUrl: 'https://goldkeyrealtygrp.com/listing',
  },
  {
    address: '13514 Ryton Ridge Ln',
    city: 'Gainesville, VA 20155',
    price: '$950,000',
    beds: 4, baths: 4, sqft: '4,376',
    status: 'For Sale',
    img: 'https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=800&q=80',
    loftyUrl: 'https://goldkeyrealtygrp.com/listing',
  },
];
---

<BaseLayout
  title="Ken Stulik | Gold Key Realty — #1 Northern Virginia REALTOR"
  description="Trusted Northern Virginia REALTOR serving Alexandria, Fairfax, and Prince William County. Expert guidance for buyers, sellers, and investors in the Bright MLS area. Call (703) 309-3527.">

  <!-- ══════════════════════════════════════════
       HERO SECTION
  ══════════════════════════════════════════ -->
  <section class="relative min-h-screen flex items-center overflow-hidden -mt-[108px]">

    <!-- Background image -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1800&q=85"
        alt="Luxury Northern Virginia home"
        class="w-full h-full object-cover object-center"
        loading="eager"
      />
      <!-- Gradient overlay: strong left, fades right -->
      <div class="absolute inset-0 bg-hero-overlay"></div>
      <!-- Bottom fade into cream -->
      <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-cream-200 to-transparent"></div>
    </div>

    <!-- Gold key line accent -->
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-gold-shimmer opacity-70 z-10"></div>

    <!-- Hero content -->
    <div class="container-site relative z-20 py-32 pt-52">
      <div class="max-w-2xl">

        <!-- Eyebrow -->
        <div class="flex items-center gap-4 mb-8 animate-fade-in">
          <div class="w-10 h-px bg-gold"></div>
          <span class="font-sans text-gold text-xs tracking-[0.4em] uppercase">
            Bright MLS — Northern Virginia
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-serif text-hero text-white font-light mb-6 text-balance
                   opacity-0 animate-fade-up" style="animation-delay:150ms; animation-fill-mode:forwards;">
          Your Key to<br/>
          <em class="not-italic text-gold">Northern Virginia</em><br/>
          Real Estate.
        </h1>

        <!-- Subheading -->
        <p class="font-sans text-white/70 text-lg font-light leading-relaxed mb-10 max-w-lg
                  opacity-0 animate-fade-up" style="animation-delay:300ms; animation-fill-mode:forwards;">
          Trusted guidance for buyers, sellers, and investors across Alexandria,
          Fairfax County, and Prince William — from someone who lives it every day.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 opacity-0 animate-fade-up"
             style="animation-delay:450ms; animation-fill-mode:forwards;">
          <a href="https://goldkeyrealtygrp.com/listing"
             target="_blank" rel="noopener"
             class="btn-primary">
            Search Homes
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/>
            </svg>
          </a>
          <a href="/sell" class="btn-outline-white">
            What's My Home Worth?
          </a>
        </div>

        <!-- Quick search bar -->
        <div class="mt-12 opacity-0 animate-fade-up"
             style="animation-delay:600ms; animation-fill-mode:forwards;">
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 p-1 flex gap-1 max-w-xl">
            <input
              type="text"
              placeholder="Search by city, zip, or address..."
              class="flex-1 bg-transparent text-white placeholder:text-white/40 font-sans text-sm px-4 py-3
                     focus:outline-none"
            />
            <a href="https://goldkeyrealtygrp.com/listing"
               target="_blank" rel="noopener"
               class="btn-primary text-[11px] py-3 px-6 shrink-0">
              Search
            </a>
          </div>
          <p class="font-sans text-white/30 text-xs mt-2 ml-1">
            Powered by Bright MLS — updated daily
          </p>
        </div>

      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-20 hidden md:flex flex-col items-center gap-2">
      <div class="w-px h-12 bg-gradient-to-b from-white/0 to-gold animate-pulse"></div>
      <span class="font-sans text-white/30 text-[10px] tracking-[0.3em] uppercase">Scroll</span>
    </div>

  </section>


  <!-- ══════════════════════════════════════════
       STATS BAR
  ══════════════════════════════════════════ -->
  <section class="bg-navy-600">
    <div class="container-site">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-white/10">
        {stats.map((s, i) => (
          <div class="stat-card opacity-0-init" data-animate style={`animation-delay:${i * 100}ms`}>
            <p class="font-serif text-3xl text-gold font-light">{s.value}</p>
            <p class="font-sans text-xs text-white/50 tracking-widest uppercase mt-1">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       SERVICES
  ══════════════════════════════════════════ -->
  <section class="py-section bg-cream-200">
    <div class="container-site">

      <div class="text-center mb-16">
        <span class="section-label">What We Do</span>
        <h2 class="font-serif text-display text-navy font-light">
          Full-Service Real Estate,<br/>
          <em class="text-gold not-italic">Done Right</em>
        </h2>
        <div class="gold-rule mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-1">
        {services.map((s, i) => (
          <div class="bg-white p-10 group hover:bg-navy-600 transition-all duration-500 cursor-pointer
                      opacity-0-init" data-animate style={`animation-delay:${i * 150}ms`}>

            <!-- Icon -->
            <div class="w-12 h-12 border border-gold/40 flex items-center justify-center mb-8
                        group-hover:border-gold/70 group-hover:bg-gold/10 transition-all duration-300">
              {s.icon === 'buy' && (
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
                </svg>
              )}
              {s.icon === 'sell' && (
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/>
                </svg>
              )}
              {s.icon === 'invest' && (
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                </svg>
              )}
            </div>

            <h3 class="font-serif text-2xl text-navy font-light mb-4
                       group-hover:text-white transition-colors duration-300">
              {s.title}
            </h3>
            <p class="font-sans text-sm text-navy/60 leading-relaxed mb-8
                      group-hover:text-white/60 transition-colors duration-300">
              {s.body}
            </p>
            <a href={s.href}
               class="font-sans text-xs tracking-[0.2em] uppercase text-gold
                      flex items-center gap-2 group-hover:gap-3 transition-all duration-300">
              {s.cta}
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/>
              </svg>
            </a>

          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════
       FEATURED LISTINGS
  ══════════════════════════════════════════ -->
  <section class="py-section bg-cream-100">
    <div class="container-site">

      <div class="flex items-end justify-between mb-12">
        <div>
          <span class="section-label">Currently Available</span>
          <h2 class="font-serif text-display text-navy font-light">
            Featured Listings
          </h2>
          <div class="gold-rule"></div>
        </div>
        <a href="https://goldkeyrealtygrp.com/listing"
           target="_blank" rel="noopener"
           class="hidden md:inline-flex btn-outline text-[11px]">
          View All Listings
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredListings.map((listing, i) => (
          <a href={listing.loftyUrl}
             target="_blank" rel="noopener"
             class="property-card opacity-0-init" data-animate style={`animation-delay:${i * 150}ms`}>

            <!-- Image -->
            <div class="relative overflow-hidden h-64">
              <img
                src={listing.img}
                alt={`${listing.address}, ${listing.city}`}
                class="property-card-img"
                loading="lazy"
              />
              <!-- Status badge -->
              <span class="absolute top-4 left-4 font-sans text-[10px] tracking-[0.2em] uppercase
                           bg-gold text-navy px-3 py-1">
                {listing.status}
              </span>
            </div>

            <!-- Info -->
            <div class="p-6">
              <p class="font-serif text-2xl text-navy font-light mb-1">{listing.price}</p>
              <p class="font-sans text-sm font-500 text-navy mb-0.5">{listing.address}</p>
              <p class="font-sans text-xs text-navy/50 mb-5">{listing.city}</p>

              <!-- Stats -->
              <div class="flex gap-6 pt-4 border-t border-cream-400">
                <div class="text-center">
                  <p class="font-serif text-lg text-navy">{listing.beds}</p>
                  <p class="font-sans text-[10px] text-navy/40 uppercase tracking-wider">Beds</p>
                </div>
                <div class="text-center">
                  <p class="font-serif text-lg text-navy">{listing.baths}</p>
                  <p class="font-sans text-[10px] text-navy/40 uppercase tracking-wider">Baths</p>
                </div>
                <div class="text-center">
                  <p class="font-serif text-lg text-navy">{listing.sqft}</p>
                  <p class="font-sans text-[10px] text-navy/40 uppercase tracking-wider">Sq Ft</p>
                </div>
              </div>
            </div>

          </a>
        ))}
      </div>

      <div class="text-center mt-8 md:hidden">
        <a href="https://goldkeyrealtygrp.com/listing"
           target="_blank" rel="noopener"
           class="btn-outline">
          View All Listings
        </a>
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════
       ABOUT KEN — TRUST SECTION
  ══════════════════════════════════════════ -->
  <section class="py-section bg-navy-600 relative overflow-hidden">

    <!-- Decorative gold key outline watermark -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 opacity-[0.03] pointer-events-none select-none">
      <svg width="600" height="600" viewBox="0 0 100 100" fill="none" stroke="white">
        <circle cx="30" cy="30" r="20" stroke-width="1"/>
        <circle cx="30" cy="30" r="12" stroke-width="1"/>
        <line x1="50" y1="30" x2="100" y2="30" stroke-width="2"/>
        <line x1="80" y1="30" x2="80" y2="42" stroke-width="2"/>
        <line x1="90" y1="30" x2="90" y2="38" stroke-width="2"/>
      </svg>
    </div>

    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Photo side -->
        <div class="relative opacity-0-init" data-animate>
          <div class="relative">
            <!-- Gold frame accent -->
            <div class="absolute -top-4 -left-4 w-full h-full border border-gold/30"></div>
            <img
              src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=800&q=80"
              alt="Ken Stulik, Gold Key Realty"
              class="w-full max-w-md mx-auto lg:mx-0 object-cover object-center relative z-10"
              style="aspect-ratio: 3/4;"
              loading="lazy"
            />
            <!-- Gold bottom accent -->
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-gold-shimmer z-20"></div>
          </div>
        </div>

        <!-- Text side -->
        <div class="opacity-0-init" data-animate style="animation-delay:200ms">
          <span class="section-label">About Ken Stulik</span>
          <h2 class="font-serif text-display text-white font-light mb-6">
            The Realtor Who<br/>
            <em class="text-gold not-italic">Keeps It Real</em>
          </h2>
          <div class="gold-rule"></div>

          <p class="font-sans text-white/70 text-base leading-loose mb-6">
            With over 15 years navigating the Northern Virginia market, Ken Stulik brings a rare combination of
            hyperlocal knowledge, honest advice, and relentless advocacy. Whether you're buying your first home
            in Manassas or selling a million-dollar colonial in Old Town Alexandria, you get the same thing:
            Ken's full attention and his best work.
          </p>
          <p class="font-sans text-white/70 text-base leading-loose mb-10">
            Gold Key Realty is backed by cutting-edge technology managed by Alex Trahan, Director of Technology —
            so your listing reaches every qualified buyer and your home search stays ahead of the market.
          </p>

          <div class="flex flex-wrap gap-4">
            <a href="/about" class="btn-outline">Meet Ken</a>
            <a href="tel:7033093527" class="btn-outline-white">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
              </svg>
              (703) 309-3527
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       AREAS WE SERVE
  ══════════════════════════════════════════ -->
  <section class="py-section bg-cream-200">
    <div class="container-site">

      <div class="text-center mb-16">
        <span class="section-label">Markets We Know</span>
        <h2 class="font-serif text-display text-navy font-light">
          South of DC.<br/>
          <em class="text-gold not-italic">Deep Local Expertise.</em>
        </h2>
        <div class="gold-rule mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {areas.map((area, i) => (
          <a href="/areas"
             class="relative overflow-hidden h-80 group opacity-0-init" data-animate
             style={`animation-delay:${i * 150}ms`}>
            <img
              src={area.img}
              alt={area.name}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-navy-fade"></div>
            <div class="absolute bottom-0 left-0 p-8">
              <p class="font-serif text-2xl text-white font-light">{area.name}</p>
              <p class="font-sans text-xs text-gold tracking-widest uppercase mt-1">{area.sub}</p>
              <div class="w-8 h-px bg-gold mt-4 group-hover:w-16 transition-all duration-300"></div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════
       HOME VALUATION CTA
  ══════════════════════════════════════════ -->
  <section class="py-section-lg bg-cream-100 relative overflow-hidden">
    <!-- Gold key watermark -->
    <div class="absolute inset-0 flex items-center justify-center opacity-[0.04] pointer-events-none">
      <img src="/images/gkr-logo-navy.png" alt="" class="w-96 h-96 object-contain" aria-hidden="true"
           onerror="this.style.display='none'" />
    </div>

    <div class="container-site text-center relative z-10">
      <span class="section-label">Free Service</span>
      <h2 class="font-serif text-display text-navy font-light mb-4 opacity-0-init" data-animate>
        What Is Your<br/>
        <em class="text-gold not-italic">Home Worth Today?</em>
      </h2>
      <div class="gold-rule mx-auto"></div>
      <p class="font-sans text-navy/60 max-w-xl mx-auto text-base leading-relaxed mb-10 opacity-0-init" data-animate>
        Get an accurate, no-obligation market analysis of your home's current value — powered by live Bright MLS data.
        Takes less than 60 seconds.
      </p>
      <a href="https://goldkeyrealtygrp.lofty.com/evaluation"
         target="_blank" rel="noopener"
         class="btn-primary opacity-0-init" data-animate>
        Get My Free Valuation
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/>
        </svg>
      </a>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       TESTIMONIALS
  ══════════════════════════════════════════ -->
  <section class="py-section bg-cream-200">
    <div class="container-site">

      <div class="text-center mb-16">
        <span class="section-label">Client Stories</span>
        <h2 class="font-serif text-display text-navy font-light">
          What Clients Say
        </h2>
        <div class="gold-rule mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map((t, i) => (
          <div class="testimonial-card opacity-0-init" data-animate style={`animation-delay:${i * 150}ms`}>
            <!-- Stars -->
            <div class="flex gap-1 mb-6">
              {[1,2,3,4,5].map(() => (
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <p class="font-serif text-lg text-navy/80 font-light leading-relaxed mb-8 italic">
              "{t.quote}"
            </p>

            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gold/20 flex items-center justify-center">
                <span class="font-serif text-gold font-light text-sm">
                  {t.name.charAt(0)}
                </span>
              </div>
              <div>
                <p class="font-sans text-sm font-500 text-navy">{t.name}</p>
                <p class="font-sans text-xs text-navy/40">{t.location}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/reviews"
           class="font-sans text-xs tracking-[0.2em] uppercase text-gold hover:text-gold-700
