---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Ken Stulik | Gold Key Realty — Northern Virginia REALTOR"
  description="Contact Ken Stulik at Gold Key Realty. Serving Alexandria, Fairfax, and Prince William County. Call (703) 309-3527 or send a message.">

  <!-- Hero -->
  <section class="relative py-32 bg-navy-600 overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-gold-shimmer opacity-70"></div>
    <div class="container-site relative z-10 text-center">
      <span class="section-label">Let's Connect</span>
      <h1 class="font-serif text-display text-white font-light mb-4">
        Ready to Talk?<br/><em class="text-gold not-italic">We're Here.</em>
      </h1>
      <div class="gold-rule mx-auto"></div>
      <p class="font-sans text-white/60 max-w-md mx-auto">
        No scripts, no pressure — just honest real estate advice from someone who knows this market.
      </p>
    </div>
  </section>

  <!-- Contact section -->
  <section class="py-section bg-cream-200">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <!-- Contact info -->
        <div>
          <span class="section-label">Direct Contact</span>
          <h2 class="font-serif text-3xl text-navy font-light mb-8">Get In Touch With Ken</h2>
          <div class="gold-rule"></div>

          <div class="space-y-8 mb-10">
            <a href="tel:7033093527"
               class="flex items-center gap-5 group">
              <div class="w-12 h-12 border border-gold/40 flex items-center justify-center
                          group-hover:bg-gold/10 transition-colors">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                </svg>
              </div>
              <div>
                <p class="font-sans text-xs text-navy/40 tracking-widest uppercase">Call or Text</p>
                <p class="font-serif text-xl text-navy font-light group-hover:text-gold transition-colors">
                  (703) 309-3527
                </p>
              </div>
            </a>

            <a href="mailto:ken@goldkeyrealtygrp.com"
               class="flex items-center gap-5 group">
              <div class="w-12 h-12 border border-gold/40 flex items-center justify-center
                          group-hover:bg-gold/10 transition-colors">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
              </div>
              <div>
                <p class="font-sans text-xs text-navy/40 tracking-widest uppercase">Email</p>
                <p class="font-serif text-xl text-navy font-light group-hover:text-gold transition-colors">
                  ken@goldkeyrealtygrp.com
                </p>
              </div>
            </a>

            <div class="flex items-center gap-5">
              <div class="w-12 h-12 border border-gold/40 flex items-center justify-center">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-sans text-xs text-navy/40 tracking-widest uppercase">Hours</p>
                <p class="font-serif text-xl text-navy font-light">Mon–Sat, 8am–7pm</p>
                <p class="font-sans text-sm text-navy/40">Available by appointment Sundays</p>
              </div>
            </div>
          </div>

          <!-- Quick links -->
          <div class="border-t border-cream-400 pt-8">
            <p class="font-sans text-xs tracking-widest uppercase text-navy/40 mb-4">Quick Actions</p>
            <div class="flex flex-col gap-3">
              <a href="https://goldkeyrealtygrp.lofty.com/evaluation"
                 target="_blank" rel="noopener"
                 class="btn-primary w-full justify-center text-[11px]">
                Get Free Home Valuation
              </a>
              <a href="https://goldkeyrealtygrp.com/listing"
                 target="_blank" rel="noopener"
                 class="btn-outline w-full justify-center text-[11px]">
                Search Available Homes
              </a>
            </div>
          </div>
        </div>

        <!-- Form — Lofty contact form embed -->
        <div class="bg-white p-10 shadow-card">
          <h3 class="font-serif text-2xl text-navy font-light mb-2">Send a Message</h3>
          <p class="font-sans text-sm text-navy/50 mb-8">We respond to all inquiries within a few hours.</p>

          <!-- REPLACE THIS SECTION with your Lofty contact form embed -->
          <!-- Found in Lofty → Website → Widgets → Contact Form -->
          <form class="space-y-5" action="#" method="POST">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="font-sans text-xs text-navy/60 tracking-wider uppercase block mb-2">First Name</label>
                <input type="text" name="first_name" required class="form-input" placeholder="Jane" />
              </div>
              <div>
                <label class="font-sans text-xs text-navy/60 tracking-wider uppercase block mb-2">Last Name</label>
                <input type="text" name="last_name" required class="form-input" placeholder="Smith" />
              </div>
            </div>
            <div>
              <label class="font-sans text-xs text-navy/60 tracking-wider uppercase block mb-2">Email</label>
              <input type="email" name="email" required class="form-input" placeholder="jane@example.com" />
            </div>
            <div>
              <label class="font-sans text-xs text-navy/60 tracking-wider uppercase block mb-2">Phone</label>
              <input type="tel" name="phone" class="form-input" placeholder="(703) 000-0000" />
            </div>
            <div>
              <label class="font-sans text-xs text-navy/60 tracking-wider uppercase block mb-2">I'm Interested In</label>
              <select name="interest" class="form-input bg-white">
                <option value="">Select one...</option>
                <option>Buying a Home</option>
                <option>Selling My Home</option>
                <option>Home Valuation</option>
                <option>Relocation</option>
                <option>Investment Property</option>
                <option>General Inquiry</option>
              </select>
            </div>
            <div>
              <label class="font-sans text-xs text-navy/60 tracking-wider uppercase block mb-2">Message</label>
              <textarea name="message" rows="4" class="form-input resize-none"
                        placeholder="Tell us a bit about what you're looking for..."></textarea>
            </div>
            <button type="submit" class="btn-primary w-full justify-center">
              Send Message
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/>
              </svg>
            </button>
            <p class="font-sans text-xs text-navy/30 text-center">
              By submitting, you agree to be contacted by Gold Key Realty regarding your inquiry.
            </p>
          </form>
          <!-- END Lofty form embed placeholder -->

        </div>
      </div>
    </div>
  </section>

</BaseLayout>
