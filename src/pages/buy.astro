---
import BaseLayout from '../layouts/BaseLayout.astro';

const priceRanges = ['Under $500K', '$500K–$750K', '$750K–$1M', '$1M–$1.5M', '$1.5M+'];
const areas = ['Alexandria', 'Fairfax', 'Springfield', 'Manassas', 'Woodbridge', 'Gainesville'];
const types = ['Single Family', 'Townhome', 'Condo', 'New Construction'];
---

<BaseLayout
  title="Search Homes For Sale | Gold Key Realty — Northern Virginia"
  description="Search every home for sale in Northern Virginia on Bright MLS. Alexandria, Fairfax County, Prince William County — find your next home with Ken Stulik at Gold Key Realty.">

  <!-- Hero -->
  <section class="relative py-28 bg-navy-600 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1400&q=70"
           alt="" class="w-full h-full object-cover" aria-hidden="true" />
    </div>
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-gold-shimmer opacity-70"></div>
    <div class="container-site relative z-10 text-center">
      <span class="section-label">Bright MLS Search</span>
      <h1 class="font-serif text-display text-white font-light mb-4">
        Find Your Perfect<br/><em class="text-gold not-italic">Northern Virginia Home.</em>
      </h1>
      <div class="gold-rule mx-auto"></div>
    </div>
  </section>

  <!-- Quick filter section -->
  <section class="py-12 bg-cream-100 border-b border-cream-400">
    <div class="container-site">
      <p class="font-sans text-xs tracking-widest uppercase text-navy/40 mb-6 text-center">
        Browse by category — all results open in our full MLS search
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Price -->
        <div>
          <p class="font-sans text-xs text-gold tracking-widest uppercase mb-3">Price Range</p>
          <div class="flex flex-wrap gap-2">
            {priceRanges.map(p => (
              <a href="https://goldkeyrealtygrp.com/listing"
                 target="_blank" rel="noopener"
                 class="font-sans text-xs text-navy border border-navy/20 px-3 py-2
                        hover:border-gold hover:text-gold transition-colors">
                {p}
              </a>
            ))}
          </div>
        </div>

        <!-- Area -->
        <div>
          <p class="font-sans text-xs text-gold tracking-widest uppercase mb-3">Area</p>
          <div class="flex flex-wrap gap-2">
            {areas.map(a => (
              <a href="https://goldkeyrealtygrp.com/listing"
                 target="_blank" rel="noopener"
                 class="font-sans text-xs text-navy border border-navy/20 px-3 py-2
                        hover:border-gold hover:text-gold transition-colors">
                {a}
              </a>
            ))}
          </div>
        </div>

        <!-- Type -->
        <div>
          <p class="font-sans text-xs text-gold tracking-widest uppercase mb-3">Property Type</p>
          <div class="flex flex-wrap gap-2">
            {types.map(t => (
              <a href="https://goldkeyrealtygrp.com/listing"
                 target="_blank" rel="noopener"
                 class="font-sans text-xs text-navy border border-navy/20 px-3 py-2
                        hover:border-gold hover:text-gold transition-colors">
                {t}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full MLS search CTA -->
  <section class="py-section bg-cream-200">
    <div class="container-site text-center">
      <span class="section-label">Live Bright MLS Data</span>
      <h2 class="font-serif text-display text-navy font-light mb-4">
        Every Listing. <em class="text-gold not-italic">Updated Daily.</em>
      </h2>
      <div class="gold-rule mx-auto"></div>
      <p class="font-sans text-navy/60 max-w-lg mx-auto leading-relaxed mb-10">
        Our full property search is powered by Bright MLS — the same database your agent uses.
        Create a free account to save searches and get instant alerts on new listings.
      </p>
      <a href="https://goldkeyrealtygrp.com/listing"
         target="_blank" rel="noopener"
         class="btn-primary">
        Open Full MLS Search
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Buyer resources -->
  <section class="py-section bg-cream-100">
    <div class="container-site">
      <div class="text-center mb-12">
        <span class="section-label">Buyer Resources</span>
        <h2 class="font-serif text-3xl text-navy font-light">Everything You Need to Buy Smart</h2>
        <div class="gold-rule mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { title: 'Mortgage Calculator', body: 'Estimate your monthly payment and see what you can afford before you fall in love with a home.', href: '#' },
          { title: 'First-Time Buyer Guide', body: 'The Northern Virginia market moves fast. This guide walks you through every step of the process.', href: '#' },
          { title: 'Relocation Services', body: 'Moving to the DMV? We specialize in making the transition smooth — from neighborhood tours to school districts.', href: '/contact' },
        ].map(r => (
          <div class="bg-white p-8 shadow-card hover:shadow-card-lg transition-shadow group">
            <h3 class="font-serif text-xl text-navy font-light mb-3 group-hover:text-gold transition-colors">{r.title}</h3>
            <p class="font-sans text-sm text-navy/60 leading-relaxed mb-6">{r.body}</p>
            <a href={r.href}
               class="font-sans text-xs tracking-widest uppercase text-gold flex items-center gap-2
                      group-hover:gap-3 transition-all">
              Learn More
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
