---

<BaseLayout
  title="Resources & Trusted Partners | Gold Key Realty — Northern Virginia"
  description="Download the Gold Key Realty Buyer Guide and meet our trusted network of local professionals — lenders, inspectors, attorneys, and more.">

  <!-- Hero -->
  <section class="relative py-28 bg-navy-600 overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-gold-shimmer opacity-70"></div>
    <div class="container-site relative z-10">
      <span class="section-label">Tools & Trusted Professionals</span>
      <h1 class="font-serif text-display text-white font-light mb-4">
        Resources for<br/><em class="text-gold not-italic">Every Step.</em>
      </h1>
      <div class="gold-rule"></div>
      <p class="font-sans text-white/60 max-w-xl leading-relaxed">
        Our commitment doesn't end at closing. Here's everything you need —
        from your first search to life in your new home.
      </p>
    </div>
  </section>

  <!-- Buyer Guide Download -->
  <section class="py-16 bg-gold">
    <div class="container-site">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <p class="font-sans text-xs tracking-widest uppercase text-navy/60 mb-2">Free Download</p>
          <h2 class="font-serif text-3xl text-navy font-light">Gold Key Realty Buyer Guide</h2>
          <p class="font-sans text-navy/70 text-sm mt-2 max-w-lg">
            Everything you need to know about buying a home in Northern Virginia —
            from pre-approval to closing day. 23 pages of straight answers.
          </p>
        </div>
        <div class="shrink-0">
          <!-- Replace href with actual PDF path once uploaded to /public/downloads/ -->
          <a href="/downloads/gkr-buyer-guide.pdf"
             download
             class="btn-primary bg-navy text-gold hover:bg-navy-700 whitespace-nowrap">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
            </svg>
            Download Free Guide
          </a>
          <p class="font-sans text-[10px] text-navy/40 text-center mt-2">PDF · No email required</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Preferred Lender -->
  <section class="py-section bg-cream-200">
    <div class="container-site">

      <div class="text-center mb-12">
        <span class="section-label">Financing Your Home</span>
        <h2 class="font-serif text-display text-navy font-light">
          Preferred <em class="text-gold not-italic">Lender</em>
        </h2>
        <div class="gold-rule mx-auto"></div>
        <p class="font-sans text-navy/60 max-w-lg mx-auto text-sm leading-relaxed">
          Gold Key Realty has built a trusted relationship with a local lending partner
          who understands the Northern Virginia market. If you don't have a lender, we'll make the introduction.
        </p>
      </div>

      <div class="max-w-2xl mx-auto bg-white shadow-card-lg border-t-2 border-gold">
        <div class="p-8">
          <div class="flex items-start justify-between mb-6">
            <div>
              <h3 class="font-serif text-2xl text-navy font-light">{lender.name}</h3>
              <p class="font-sans text-gold text-sm tracking-wider mt-1">{lender.company}</p>
            </div>
            <div class="w-12 h-12 bg-navy-600 flex items-center justify-center shrink-0">
              <span class="font-serif text-gold font-light">SP</span>
            </div>
          </div>
          <div class="gold-rule"></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {[
              { label: 'Mobile', value: lender.mobile, href: `tel:${lender.mobile.replace(/\D/g,'')}` },
              { label: 'Email', value: lender.email, href: `mailto:${lender.email}` },
              { label: 'Web', value: lender.web, href: `https://${lender.web}` },
              { label: 'Office', value: lender.address, href: null },
            ].map(item => (
              <div>
                <p class="font-sans text-[10px] text-navy/40 tracking-widest uppercase mb-1">{item.label}</p>
                {item.href ? (
                  <a href={item.href}
                     class="font-sans text-sm text-navy hover:text-gold transition-colors">
                    {item.value}
                  </a>
                ) : (
                  <p class="font-sans text-sm text-navy/70">{item.value}</p>
                )}
              </div>
            ))}
          </div>
        </div>
        <div class="bg-cream-100 px-8 py-4 border-t border-cream-400">
          <p class="font-sans text-xs text-navy/40 leading-relaxed">
            Gold Key Realty has no financial relationship with this lender.
            This referral is based solely on client experience and professional trust.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Trusted Vendors -->
  <section class="py-section bg-cream-100">
    <div class="container-site">

      <div class="text-center mb-12">
        <span class="section-label">After the Keys</span>
        <h2 class="font-serif text-display text-navy font-light">
          Trusted Service<br/><em class="text-gold not-italic">Professionals</em>
        </h2>
        <div class="gold-rule mx-auto"></div>
        <p class="font-sans text-navy/60 max-w-lg mx-auto text-sm leading-relaxed">
          Every professional below has been personally vetted by Ken.
          These are the people we call for our own homes.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {vendors.map(v => (
          <div class="bg-white shadow-card hover:shadow-card-lg transition-shadow p-6 group">

            <!-- Icon + Category -->
            <div class="flex items-center gap-3 mb-5 pb-5 border-b border-cream-400">
              <div class="w-9 h-9 border border-gold/40 flex items-center justify-center shrink-0
                          group-hover:bg-gold/10 transition-colors">
                <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor"
                     stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icons[v.icon]}/>
                </svg>
              </div>
              <p class="font-sans text-[10px] text-navy/50 tracking-widest uppercase leading-tight">
                {v.category}
              </p>
            </div>

            <!-- Name + Company -->
            <h3 class="font-serif text-lg text-navy font-light mb-1">{v.name}</h3>
            {v.company && (
              <p class="font-sans text-xs text-gold tracking-wide mb-4">{v.company}</p>
            )}
            {!v.company && <div class="mb-4"></div>}

            <!-- Contact details -->
            <div class="flex flex-col gap-2">
              {v.phone && (
                <a href={`tel:${v.phone.replace(/\D/g,'')}`}
                   class="flex items-center gap-2 group/link">
                  <svg class="w-3 h-3 text-gold/60 shrink-0" fill="none" stroke="currentColor"
                       stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                  </svg>
                  <span class="font-sans text-xs text-navy/70 group-hover/link:text-gold transition-colors">
                    {v.phone}
                  </span>
                </a>
              )}
              {v.email && (
                <a href={`mailto:${v.email}`}
                   class="flex items-center gap-2 group/link">
                  <svg class="w-3 h-3 text-gold/60 shrink-0" fill="none" stroke="currentColor"
                       stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                  </svg>
                  <span class="font-sans text-xs text-navy/70 group-hover/link:text-gold transition-colors truncate">
                    {v.email}
                  </span>
                </a>
              )}
              {v.web && (
                <a href={`https://${v.web}`} target="_blank" rel="noopener"
                   class="flex items-center gap-2 group/link">
                  <svg class="w-3 h-3 text-gold/60 shrink-0" fill="none" stroke="currentColor"
                       stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253"/>
                  </svg>
                  <span class="font-sans text-xs text-navy/70 group-hover/link:text-gold transition-colors truncate">
                    {v.web}
                  </span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <p class="font-sans text-xs text-navy/30 text-center mt-8 max-w-lg mx-auto leading-relaxed">
        Gold Key Realty has no financial relationship with any vendor listed above.
        All referrals are based solely on personal experience and professional trust.
      </p>

    </div>
  </section>

  <!-- FAQ link strip -->
  <section class="py-16 bg-navy-600">
    <div class="container-site flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="font-serif text-2xl text-white font-light">Have more questions?</p>
        <p class="font-sans text-white/50 text-sm mt-1">
          Visit our FAQ page for straight answers to the most common buyer questions.
        </p>
      </div>
      <a href="/faq" class="btn-outline shrink-0">View All FAQs</a>
    </div>
  </section>

</BaseLayout>
